# انسخه إلى .env على الاستضافة

# الاقتران الآلي (يمنع توقّف البوت عند انتظار إدخال من الطرفية)
# 1 = رمز اقتران، 2 = رمز QR
PAIR_METHOD=1
PAIR_PHONE=201140875066

# صفحة اختيار خلفية المجموعة
# المنفذ: THEME_UPLOAD_PORT ثم SERVER_PORT الذي يوفّره المستضيف ثم 12000
# THEME_UPLOAD_PORT=25850
#
# رابط الصفحة العام (يُفتح من الهاتف، فلا يصلح localhost):
# يُقرأ تلقائياً من THEME_UPLOAD_BASE، أو PUBLIC_URL/SERVER_URL/RENDER_EXTERNAL_URL،
# أو SERVER_IP على استضافات Pterodactyl. بدون أي منها لن يُرسل زر الصفحة.
# THEME_UPLOAD_BASE=https://your-domain.com
